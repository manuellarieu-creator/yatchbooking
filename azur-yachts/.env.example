# Base de données (Supabase PostgreSQL)
# Trouvez ces liens dans les paramètres de votre projet Supabase (Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres.[PROJET]:[MOTDEPASSE]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJET]:[MOTDEPASSE]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# NextAuth
# Générez un secret avec : npx auth secret
AUTH_SECRET="votre_secret_genere"
AUTH_URL="http://localhost:3000"

# Cloudinary (Hébergement d'images pour les Yachts)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe (Paiements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (Envoi d'emails)
RESEND_API_KEY=""
