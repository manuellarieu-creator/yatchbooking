generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  ADVERTISER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTargetType {
  SITE
  OWNER
  LISTING
}

enum AdvertiserTier {
  STANDARD
  PREMIUM
  PLATINIUM
}

enum ListingStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AWAITING_PROOF
  PROOF_SUBMITTED
  VERIFIED
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_NEW
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  LISTING_APPROVED
  LISTING_REJECTED
  ACCOUNT_APPROVED
  NEW_MESSAGE
  PAYMENT_RECEIVED
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  password                String?
  firstName               String
  lastName                String
  role                    Role                      @default(CLIENT)
  status                  UserStatus                @default(PENDING)
  isEmailVerified         Boolean                   @default(false)
  isManagedByAdmin        Boolean                   @default(false)
  emailVerifyToken        String?
  videoVerified           Boolean                   @default(false)
  videoUrl                String?
  idCardUrl               String?
  idCardBackUrl           String?
  advertiserTier          AdvertiserTier?
  countryResidence        String?
  languages               String[]
  avatar                  String?
  phone                   String?
  bio                     String?
  resetToken              String?
  resetTokenExpiry        DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  accounts                Account[]
  sessions                Session[]
  listings                Listing[]
  bookings                Booking[]
  reviews                 Review[]                  @relation("ReviewAuthor")
  receivedReviews         Review[]                  @relation("ReviewTarget")
  sentMessages            Message[]
  conversations           ConversationParticipant[]
  notifications           Notification[]
  twoFactorEmailEnabled   Boolean                   @default(false)
  twoFactorSecret         String?
  favorites               Favorite[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences Json?
  boatLicenseUrl          String?
  boatLicenseVerified     Boolean                   @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  deviceInfo   String?
  location     String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id                String         @id @default(cuid())
  title             String
  description       String         @db.Text
  price             Float
  salePrice         Float?
  trialPrice        Float?
  saleOfferType     String?
  country           String
  location          String
  latitude          Float?
  longitude         Float?
  isAtSea           Boolean        @default(false)
  status            ListingStatus  @default(PENDING)
  rejectionReason   String?
  maxAdults         Int
  maxChildren       Int
  boatType          String
  boatLength        Float?
  boatYear          Int
  cabins            Int?
  berths            Int?
  bathrooms         Int?
  boatPlanUrls      String[]       @default([])
  requiresCaptain   Boolean        @default(false)
  skipperAvailable  Boolean        @default(false)
  requiresLicense   Boolean        @default(true)
  enginePower       Int?
  maxRentalHours    Int?
  deliveryAvailable Boolean        @default(false)
  deliveryFee       Float?
  deliveryPricing   Json?
  features          String[]       @default([])
  navigationMode    String         @default("INCLUDED")
  fuelIncluded      Boolean        @default(false)
  fuelQuantity      String?
  fuelPricePerDay   Float?
  cleaningFee       Float
  securityDeposit   Float          @default(0)
  captainPrice      Float?
  skipperPrice      Float?
  averageRating     Float          @default(0)
  reviewCount       Int            @default(0)
  viewCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  owner             User           @relation(fields: [ownerId], references: [id])
  ownerId           String
  images            ListingImage[]
  availabilities    Availability[]
  services          Service[]
  bookings          Booking[]
  reviews           Review[]
  favorites         Favorite[]
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  publicId  String
  order     Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

model Availability {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  type      String   @default("AVAILABLE")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

model Service {
  id          String  @id @default(cuid())
  name        String
  price       Float
  unit        String  @default("PER_BOOKING")
  description String?
  isRequired  Boolean @default(false)
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
}

model Booking {
  id                 String           @id @default(cuid())
  startDate          DateTime
  endDate            DateTime
  totalNights        Int
  basePrice          Float
  cleaningFee        Float
  deliveryFee        Float            @default(0)
  servicesTotal      Float            @default(0)
  discountAmount     Float            @default(0)
  discountCode       String?
  securityDeposit    Float            @default(0)
  totalPrice         Float
  adults             Int
  children           Int
  pets               Boolean          @default(false)
  deliveryRequested  Boolean          @default(false)
  deliveryPort       String?
  status             BookingStatus    @default(PENDING)
  adminNote          String?
  modificationStatus String?
  requestedStartDate DateTime?
  requestedEndDate   DateTime?
  requestedNote      String?          @db.Text
  modificationFee    Float            @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  listing            Listing          @relation(fields: [listingId], references: [id])
  listingId          String
  client             User             @relation(fields: [clientId], references: [id])
  clientId           String
  selectedServices   BookingService[]
  payment            Payment?
}

model BookingService {
  id        String  @id @default(cuid())
  name      String
  price     Float
  unit      String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
}

model Payment {
  id                    String        @id @default(cuid())
  amount                Float
  currency              String        @default("EUR")
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeClientSecret    String?
  paypalOrderId         String?
  paypalCaptureId       String?
  bankTransferRef       String?
  bankProofUrl          String?
  bankProofPublicId     String?
  bankProofSubmittedAt  DateTime?
  paymentDeadline       DateTime?
  reminder1SentAt       DateTime?
  reminder2SentAt       DateTime?
  booking               Booking       @relation(fields: [bookingId], references: [id])
  bookingId             String        @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model PaymentSettings {
  id                    String        @id @default(cuid())
  activeMethod          PaymentMethod @default(STRIPE)
  stripeEnabled         Boolean       @default(true)
  stripePublicKey       String?
  stripeSecretKey       String?
  stripeWebhookSecret   String?
  paypalEnabled         Boolean       @default(false)
  paypalClientId        String?
  paypalClientSecret    String?
  paypalMode            String        @default("sandbox")
  bankEnabled           Boolean       @default(false)
  bankAccountName       String?
  bankIban              String?
  bankBic               String?
  bankName              String?
  bankNotificationEmail String?
  updatedAt             DateTime      @updatedAt
}

model Review {
  id           String           @id @default(cuid())
  rating       Int
  comment      String           @db.Text
  status       ReviewStatus     @default(PENDING)
  targetType   ReviewTargetType @default(LISTING)
  listing      Listing?         @relation(fields: [listingId], references: [id])
  listingId    String?
  targetUser   User?            @relation("ReviewTarget", fields: [targetUserId], references: [id])
  targetUserId String?
  author       User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId     String
  createdAt    DateTime         @default(now())
}

model Conversation {
  id           String                    @id @default(cuid())
  listingId    String?
  listingTitle String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id              String       @id @default(cuid())
  content         String       @db.Text
  isAdminReply    Boolean      @default(false)
  displayAsUserId String?
  sender          User         @relation(fields: [senderId], references: [id])
  senderId        String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  conversationId  String
  readAt          DateTime?
  createdAt       DateTime     @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime         @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Destination {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String?
  gradient  String?
  isLarge   Boolean  @default(false)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  category String @default("Général")
  order    Int
}

model DiscountCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Float
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Blacklist {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id                String   @id @default("default")
  satisfiedClients  String   @default("12K+")
  yearsOfExcellence String   @default("15")
  maintenanceMode   Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}
